name: CI

# 任意で有効化する。JDK のバージョンとブランチ名を確認した後、ci.yml に変更する。
# マージの可否はこの workflow とブランチ保護（required checks）で判定する。
# AI ツールのセッション内で実行した検証は、この判定の代わりにならない。
on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
          cache: maven
      # .claude/rules/ を編集したのに Copilot 用の生成物を更新していない場合に失敗する。
      - name: Generated Copilot instructions are in sync
        run: python3 scripts/sync_rules.py --check
      # 修正指示から作ったルール（config/guard/rules.json）。新しい違反、期限切れの例外、壊れたルールで失敗する。
      - name: Deterministic checks (guard)
        run: python3 scripts/guard.py
      # Excel 設計書を使用する場合は有効にする（Python 3.11+ と変換ツールのインストールが必要）。
      # - name: Converted Excel specs are up to date
      #   run: python3 scripts/xlsx2ai.py --check
      - name: Build and test
        run: ./mvnw -B verify

  # 画面試験（screen-tests/ を導入している場合に有効にする）。アプリケーションの起動方法とテストデータの
  # 初期化はプロジェクトに合わせる。資格情報は合成データのテストアカウントを Secrets から渡す。
  # screen-tests:
  #   runs-on: ubuntu-latest
  #   timeout-minutes: 30
  #   env:
  #     TEST_ENGINE: playwright
  #     TEST_BROWSER_CHANNEL: chromium
  #   steps:
  #     - uses: actions/checkout@v4
  #       with:
  #         persist-credentials: false
  #     - uses: actions/setup-java@v4
  #       with:
  #         distribution: temurin
  #         java-version: '21'
  #         cache: maven
  #     - uses: actions/setup-node@v4
  #       with:
  #         node-version: '22'
  #     - name: Start the application
  #       run: |
  #         ./mvnw -B -q spring-boot:run > app.log 2>&1 &
  #         for _ in $(seq 1 90); do curl -fsS http://localhost:8080/ > /dev/null 2>&1 && break; sleep 2; done
  #     - name: Run screen tests
  #       working-directory: screen-tests
  #       run: |
  #         npm install --no-audit --no-fund
  #         npx playwright install --with-deps chromium
