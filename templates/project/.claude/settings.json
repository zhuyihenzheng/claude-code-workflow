{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw -q compile)",
      "Bash(./mvnw -B -q compile)",
      "Bash(./mvnw test)",
      "Bash(./mvnw verify)",
      "Bash(mvnw.cmd -q compile)",
      "Bash(mvnw.cmd -B -q compile)",
      "Bash(mvnw.cmd test)",
      "Bash(mvnw.cmd verify)",
      "Bash(./mvnw.cmd -q compile)",
      "Bash(./mvnw.cmd -B -q compile)",
      "Bash(./mvnw.cmd test)",
      "Bash(./mvnw.cmd verify)",
      "PowerShell(.\\mvnw.cmd -q compile)",
      "PowerShell(.\\mvnw.cmd -B -q compile)",
      "PowerShell(.\\mvnw.cmd test)",
      "PowerShell(.\\mvnw.cmd verify)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh pr view *)",
      "Bash(gh issue view *)"
    ],
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/*credentials*)",
      "Read(/**/*secret*)",
      "Edit(/**/.env)",
      "Edit(/**/.env.*)",
      "Edit(/**/*credentials*)",
      "Edit(/**/*secret*)",
      "Read(/**/*.xlsx)",
      "Read(/**/*.xlsm)",
      "Bash(rm -rf /*)",
      "Bash(git push --force *)"
    ],
    "ask": [
      "Edit(/src/main/resources/db/migration/**)"
    ]
  }
}
