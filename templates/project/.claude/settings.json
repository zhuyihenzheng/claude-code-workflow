{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-stop.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./mvnw -q compile)",
      "Bash(./mvnw test)",
      "Bash(./mvnw verify)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh pr view *)",
      "Bash(gh issue view *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/*credentials*)",
      "Read(/**/*secret*)",
      "Edit(/.env)",
      "Edit(/.env.*)",
      "Edit(/**/.env)",
      "Edit(/**/.env.*)",
      "Edit(/**/*credentials*)",
      "Edit(/**/*secret*)",
      "Bash(rm -rf /*)",
      "Bash(git push --force *)"
    ],
    "ask": [
      "Edit(/src/main/resources/db/migration/**)"
    ]
  }
}
